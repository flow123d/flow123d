#!/bin/bash
# Run a Python API test using the active Flow123d build.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -d "${1:-}" ]; then
    test_dir="$1"
    shift
    script_list="$(mktemp)" || exit 1
    trap 'rm -f "$script_list"' EXIT
    "${SCRIPT_DIR}/../bin/python" - "$test_dir" > "$script_list" <<'PY'
import os
import sys
import yaml

test_dir = sys.argv[1]
try:
    with open(os.path.join(test_dir, 'py_config.yaml'), encoding='utf-8') as config:
        data = yaml.safe_load(config)
except FileNotFoundError:
    sys.exit('User error: Configuration file py_config.yaml not found!')

if (not isinstance(data, dict) or not isinstance(data.get('test_cases'), list)
        or not data['test_cases']
        or any(not isinstance(case, dict) or 'files' not in case for case in data['test_cases'])):
    sys.exit("User error: Missing obligatory key 'test_cases/files' in py_config.yaml!")

for case in data['test_cases']:
    for script in case['files']:
        sys.stdout.buffer.write(os.fsencode(os.path.join(test_dir, script)) + b'\0')
PY
    if [ "$?" -ne 0 ]; then
        exit 1
    fi
    status=0
    passed=0
    failed=0
    results=()
    started=$SECONDS
    while IFS= read -r -d '' script; do
        case_started=$SECONDS
        echo "---------------------------------------------------------------------"
        echo -e "--- Starting test $script"
        if "${SCRIPT_DIR}/../bin/python" -m py123d.bin.compare_python_test "$test_dir" "$script" --prepare &&
           "${SCRIPT_DIR}/../bin/python" "$script" "$@" &&
           "${SCRIPT_DIR}/../bin/python" -m py123d.bin.compare_python_test "$test_dir" "$script"; then
            results+=("$(printf '[ PASSED ]  | %-45s [%5.2f sec]' "$script" "$((SECONDS - case_started))")")
            ((passed+=1))
        else
            status=1
            results+=("$(printf '[ FAILED ]  | %-45s [%5.2f sec]' "$script" "$((SECONDS - case_started))")")
            ((failed+=1))
        fi
        echo "---------------------------------------------------------------------"
        echo
    done < "$script_list"
    echo "---------------------------------------------------------------------"
    echo "SUMMARY"
    echo "---------------------------------------------------------------------"
    printf '%s\n' "${results[@]}"
    echo "---------------------------------------------------------------------"
    if [ "$status" -eq 0 ]; then overall='[ PASSED ]'; else overall='[ FAILED ]'; fi
    printf '%-11s | passed=%d, failed=%d, skipped=0 in [%5.2f sec]\n' \
        "$overall" "$passed" "$failed" "$((SECONDS - started))"
    exit "$status"
fi
exec "${SCRIPT_DIR}/../bin/python" "$@"
